# Used by Server Components (server-side fetches). In Docker Compose this becomes the
# internal service hostname, e.g. http://backend:8090 - the browser never sees this one.
API_URL=http://localhost:8090

# Used by client-side code (browser). Must stay reachable from the user's machine, so it
# stays http://localhost:8090 even when the frontend runs in Docker Compose.
NEXT_PUBLIC_API_URL=http://localhost:8090
NEXT_PUBLIC_WS_URL=ws://localhost:8090/ws
